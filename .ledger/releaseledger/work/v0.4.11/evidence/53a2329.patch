+        if result.get("next_command"):
+            lines.append(f"Next: {result['next_command']}")
+        return result, [], "\n".join(lines)
+
+    run_command(
+        command="repair.index",
+        result_type="index_repair",
+        json_output=state.json_output,
+        produce=produce,
+        workspace_root=state.root,
+        mutating=apply,
+    )
